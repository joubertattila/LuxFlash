; LuxFlash - WiFi credentials template.
;
; Copy this file to "wifi_secrets.ini" (same folder) and fill in your
; own SSID/password - if this file is missing, the build stops at
; WiFlashApp.cpp's #error lines, with a clear error message.
;
; Same mechanism as in WiFlash (see doc/LuxFlash_terv.md "WiFi-jelszo:
; egyetlen forrasra egyszerusitve" / "WiFi password: simplified to a
; single source") - used by BOTH WiFi connections in main.cpp (WiFlash's
; own OTA check AND the light-sensor server, since both run on the same
; Esp8285WiFi AT layer - see doc/LuxFlash_terv.md's "FONTOS FELFEDEZES
; build kozben" section for why there's only one driver, not two).

[env]
build_flags =
    -D WIFLASH_WIFI_SSID=\"your-ssid\"
    -D WIFLASH_WIFI_PASSWORD=\"your-password\"
